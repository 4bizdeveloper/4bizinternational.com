        <div className="absolute bottom-[15%] right-[-5%] w-[75vw] h-[75vw] rounded-full bg-gradient-to-bl from-purple-600/15 via-blue-500/10 to-transparent blur-[140px] mix-blend-screen transform-gpu" />
        <div className="absolute top-[40%] left-[20%] w-[50vw] h-[50vw] rounded-full bg-blue-400/5 blur-[160px] transform-gpu" />
      </div>

      {/* ─── HERO SECTION ─── */}
